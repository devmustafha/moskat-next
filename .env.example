# Copy to .env and fill in. Never commit .env.
# On Vercel, set the runtime variables (marked *) in Project Settings → Environment Variables,
# with separate values for Production and Preview (see README: Database).

# Neon owner connection string, *direct* (no "-pooler" in the host). Used on your machine by the
# db:* and auth:* scripts and by `npm run dev`. Point it at a non-production branch.
# * On Vercel, DATABASE_URL is instead the *pooled* string for the limited moskat_web user.
DATABASE_URL=postgresql://neondb_owner:<password>@<dev-branch-host>/neondb?sslmode=verify-full

# Neon `main` branch (production), direct owner string. Only for releases:
#   DATABASE_URL=$DATABASE_URL_MAIN npm run db:migrate
DATABASE_URL_MAIN=postgresql://neondb_owner:<password>@<main-branch-host>/neondb?sslmode=verify-full

# * Authentication (Better Auth), one pair per environment. Generate each with:
#   openssl rand -base64 32
# PASSWORD_PEPPER must never change once accounts exist (every password would stop working).
BETTER_AUTH_SECRET=<random, at least 32 characters>
PASSWORD_PEPPER=<random, at least 32 characters>

# * The site's public origin. Optional locally (defaults to http://localhost:3000) and on Vercel
#   previews (each uses its own URL); set it for Production.
# BETTER_AUTH_URL=https://<your-domain>

# * Resend API key for booking emails. Without it, bookings still work; patients see them in
#   their account.
RESEND_API_KEY=

# * Paystack secret key: sk_test_… for local and Preview, sk_live_… for Production only.
#   Used server-side for checkout and verification, and as the HMAC key that signs webhooks.
#   Never prefix it NEXT_PUBLIC_. In the Paystack dashboard (Settings → API Keys & Webhooks), for
#   each mode set the webhook URL to https://<host>/api/webhooks/paystack.
PAYSTACK_SECRET_KEY=

# * Shared secret for the daily job (/api/cron/maintenance); Vercel Cron sends it automatically.
CRON_SECRET=<random string>

# Optional: production origin, so `npm run auth:check` refuses to run against it.
# PRODUCTION_URL=https://<your-domain>
